generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  name         String
  email        String              @unique
  passwordHash String
  phone        String?
  city         String?
  address      String?
  createdAt    DateTime            @default(now())
  resetCodes   PasswordResetCode[]
  cartItems    CartItem[]
  orders       Order[]
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameEn      String
  description String
  image       String
  sortOrder   Int       @default(0)
  filters     String    // JSON: [{ key, label, type, options[] }]
  products    Product[]
}

model Product {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  description    String
  brand          String
  price          Float
  oldPrice       Float?
  currency       String             @default("GEL")
  rating         Float
  reviewsCount   Int
  stock          Int
  warrantyMonths Int
  images         String             // JSON: string[]
  specs          String             // JSON: Record<string, string>
  categoryId     String
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributes     ProductAttribute[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime           @default(now())

  @@index([categoryId])
  @@index([brand])
  @@index([price])
  @@index([rating])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@index([productId])
  @@index([key, value])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

/// შეკვეთა ინახავს პროდუქტების „სურათს" შეკვეთის მომენტისთვის — კატალოგის
/// გადაგენერირება ან ფასის შეცვლა ისტორიას არ ცვლის.
model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String      // pending_payment | paid
  subtotal        Float
  shippingFee     Float
  total           Float
  currency        String      @default("GEL")
  fullName        String
  phone           String
  city            String
  address         String
  cardBrand       String
  cardLast4       String
  codeHash        String?
  codeExpiresAt   DateTime?
  codeAttempts    Int         @default(0)
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug      String
  title     String
  image     String
  price     Float
  qty       Int

  @@index([orderId])
}

model Meta {
  key   String @id
  value String
}
