DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
ACCESS_TOKEN_TTL="30m"
RESET_TOKEN_TTL="10m"
PORT=4000

# დიდაქტიკური პარამეტრები — ლექტორისთვის
ARTIFICIAL_LATENCY_MS=0        # 800 → ყველა მოთხოვნა 800ms-ს აყოვნებს (loading-მდგომარეობებისთვის)
DEV_EXPOSE_RESET_CODE=true     # true → აღდგენის კოდი ბრუნდება პასუხში (ელფოსტის გარეშე ტესტირებისთვის)

# დეპლოისთვის
# CORS_ORIGINS=https://team-alpha.vercel.app,https://team-beta.netlify.app

# ელფოსტა (არასავალდებულო) — თუ არ არის, კოდი მხოლოდ კონსოლში/devCode-ში იქნება
