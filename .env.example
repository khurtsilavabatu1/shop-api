DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
ACCESS_TOKEN_TTL="30m"
RESET_TOKEN_TTL="10m"
PORT=4000

# დიდაქტიკური პარამეტრები — ლექტორისთვის
ARTIFICIAL_LATENCY_MS=0        # 800 → ყველა მოთხოვნა 800ms-ს აყოვნებს (loading-მდგომარეობებისთვის)
DEV_EXPOSE_RESET_CODE=true     # true → აღდგენის კოდი ბრუნდება პასუხში (ელფოსტის გარეშე ტესტირებისთვის)

# დეპლოისთვის
# CORS_ORIGINS=https://team-alpha.vercel.app,https://team-beta.netlify.app

# ელფოსტა (არასავალდებულო). პრიორიტეტი: BREVO_API_KEY > SMTP_* > კონსოლი
#
# ✅ რეკომენდებული — HTTP API (პორტი 443, PaaS-ები არ ბლოკავს)
# BREVO_API_KEY=xkeysib-...
#
# ⚠️ SMTP — Render-ის უფასო ინსტანსზე პორტი 587 დაბლოკილია (Connection timeout)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Cyber <noreply@example.com>
